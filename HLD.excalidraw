    {
      "id": "TMJhvqvxdxDcRRwnlQl_K",
      "type": "text",
      "x": -796.9868717023801,
      "y": -220.70268091754951,
      "width": 1320.1318480489742,
      "height": 292.01840510355737,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 194710325,
      "version": 1350,
      "versionNonce": 1162475925,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793689670614,
      "created": 1793643103376,
      "link": null,
      "locked": false,
      "text": "Volume/day: 1 million emails.\nPeak 1K emails/sec during CSV uploads.\ni am assuming that Full email body which is HTML≈10 KB\nIf 1 million full emails are stored directly in Redis: 10Gb\n10 GB Ram we would need \nArch. Decision: Store full content in PostGres and we will use lightweight queue payloads in\nRedis containing only database references ({ scheduledEmailId, idempotencyKey } \n≈100 bytes\nSo my footprint of redis would b less than 100MB",
      "fontSize": 25.957191564760656,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Volume/day: 1 million emails.\nPeak 1K emails/sec during CSV uploads.\ni am assuming that Full email body which is HTML≈10 KB\nIf 1 million full emails are stored directly in Redis: 10Gb\n10 GB Ram we would need \nArch. Decision: Store full content in PostGres and we will use lightweight queue payloads in Redis containing only database references ({ scheduledEmailId, idempotencyKey } \n≈100 bytes\nSo my footprint of redis would b less than 100MB",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
