      "updated": 1793724026017,
      "link": null,
      "locked": false,
      "text": "If you send 500 emails in 2\n minutes from a single inbox,\n Google and Microsoft \nimmediately flag your domain\nas spam.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If you send 500 emails in 2\n minutes from a single inbox,\n Google and Microsoft \nimmediately flag your domain as spam.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1793642579204,
      "labelPosition": null,
      "baseFontSize": null
    },
