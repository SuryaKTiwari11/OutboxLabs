      "updated": 1793689670614,
      "created": 1793651104295,
      "link": null,
      "locked": false,
      "text": "v1/api/emails/schedule POST\n{\nrecipientEmail,\nsubject, \nbody, \nscheduledAt, \nsenderId } -> 201 Created ScheduledEmail object\n\nv1/api/emails/bulkSchedule POST\n{\nrecipients: [], \nsubject, \nbody, \nstartAt,\ndelayBetweenMs, \nhourlyLimit, \nsenderId \n}\n\nv1/api/emails/scheduled?page=1&limit=20 GET\n->(Returns PENDING, QUEUED, PROCESSING)\n\nv1/api/emails/sent?page=1&limit=20 GET\n->(Returns SENT with etherealPreviewUrl)\n\nv1/api/emails/search?q=followup&status=SENT&page=1 GET\n\nv1/api/senders POST OR GET \n\nv1/api/slack/connect -> redirects slack.com/oauth GET\n\nv1/admin/queues GET\n\nv1/metrics\n",
      "fontSize": 27.99999999999998,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "v1/api/emails/schedule POST\n{\nrecipientEmail,\nsubject, \nbody, \nscheduledAt, \nsenderId } -> 201 Created ScheduledEmail object\n\nv1/api/emails/bulkSchedule POST\n{\nrecipients: [], \nsubject, \nbody, \nstartAt,\ndelayBetweenMs, \nhourlyLimit, \nsenderId \n}\n\nv1/api/emails/scheduled?page=1&limit=20 GET\n->(Returns PENDING, QUEUED, PROCESSING)\n\nv1/api/emails/sent?page=1&limit=20 GET\n->(Returns SENT with etherealPreviewUrl)\n\nv1/api/emails/search?q=followup&status=SENT&page=1 GET\n\nv1/api/senders POST OR GET \n\nv1/api/slack/connect -> redirects slack.com/oauth GET\n\nv1/admin/queues GET\n\nv1/metrics\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    }
