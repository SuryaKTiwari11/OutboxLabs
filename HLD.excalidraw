      "updated": 1793689670614,
      "created": 1793642649484,
      "link": null,
      "locked": false,
      "text": "1.Single & Bulk Scheduling\n2.Delayed Dispatch Engine (Cron job isn't allowed)\n3.Multi-Sender SMTP Delivery\n4.Distributed Hourly Rate Limiting\n5.Provider Throttling\n6.Slack OAuth & Rate Limit Alerting\n7.Full Text Search\n8.RT Observability Dashboard\n9.User Authentication\n",
      "fontSize": 25.957191564760656,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.Single & Bulk Scheduling\n2.Delayed Dispatch Engine (Cron job isn't allowed)\n3.Multi-Sender SMTP Delivery\n4.Distributed Hourly Rate Limiting\n5.Provider Throttling\n6.Slack OAuth & Rate Limit Alerting\n7.Full Text Search\n8.RT Observability Dashboard\n9.User Authentication\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
