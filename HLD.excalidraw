        }
      ],
      "updated": 1793689670614,
      "link": null,
      "locked": false,
      "text": "If your server crashes and\nrestarts, sending the same\ncold pitch twice to a\nprospect ruins the business's\nreputation.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If your server crashes and restarts, sending the same cold pitch twice to a prospect ruins the business's reputation.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1793642579204,
      "labelPosition": null,
      "baseFontSize": null
    },
