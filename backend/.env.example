# ─────────────────────────────────────────────────────────────
#  ReachInbox Backend Environment Variables (.env.example)
# ─────────────────────────────────────────────────────────────

# ── Application ──
NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ── Database (PostgreSQL) ──
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public"

# ── Redis (BullMQ queue & rate limiting) ──
# For local Docker:
REDIS_HOST=localhost
REDIS_PORT=6379
# Or Upstash Redis connection string (if running without local Redis):
# REDIS_URL=rediss://default:your_token@your_db.upstash.io:6379

# ── Elasticsearch (Optional fallback enabled) ──
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_EMAILS=emails

# ── Google OAuth 2.0 ──
# 1. Create a project at https://console.cloud.google.com/
# 2. Go to APIs & Services > Credentials > Create Credentials > OAuth client ID (Web Application)
# 3. Add Authorized Redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_real_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_real_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Slack OAuth (Optional) ──
SLACK_CLIENT_ID=dev_slack_client_id
SLACK_CLIENT_SECRET=dev_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ── Security & JWT ──
SESSION_SECRET=e7b4a621c9d8324e98f01b5c2a3d4e5f67890123456789abcdef0123456789ab
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=supersecretjwtkey_reachinbox_staff_level_scheduler_2026
JWT_EXPIRY=7d

# ── Ethereal SMTP (Test email server) ──
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# ── BullMQ & Rate Limiter Configuration ──
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ── Bull Board Dashboard (/admin/queues) ──
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin_secret

