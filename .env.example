# ─────────────────────────────────────────────────────────────
#  ReachInbox Email Scheduler — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public"

# ── Redis ─────────────────────────────────────────────────────
# For Upstash Redis (Production / Render):
# REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379
# For Local Redis (Docker):
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=          # Uncomment if Redis has auth enabled

# ── Elasticsearch ─────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_EMAILS=emails

# ── Google OAuth ──────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Slack OAuth ───────────────────────────────────────────────
# Create at https://api.slack.com/apps
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ── Security ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_64_char_random_hex_here
# AES-256 encryption key for Slack OAuth tokens (32 bytes = 64 hex chars)
ENCRYPTION_KEY=your_32_byte_encryption_key_hex_here
# JWT secret
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=7d

# ── Ethereal SMTP (fake SMTP for testing) ─────────────────────
# Generate at https://ethereal.email/create (or auto-generated in code)
# You can leave these blank to let the app auto-create a test account on startup.
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# ── BullMQ / Scheduler Config ─────────────────────────────────
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ── Bull Board (queue dashboard) ─────────────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin_secret
